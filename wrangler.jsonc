{
  // Meagley Web Design main site (https://meagley.tech). Publish: commit, then run  bash deploy.sh
  "name": "meagley-web",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "routes": [{ "pattern": "meagley.tech", "custom_domain": true }],
  // pages are plain files (free); only the visitor counter runs code
  "assets": { "directory": "./dist", "binding": "ASSETS", "html_handling": "auto-trailing-slash", "not_found_handling": "404-page", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "meagley-stats", "database_id": "8114bca9-aa3b-44a7-84f7-62c21a04839b" }]
}
